# ==============================================================================
# Oracle 23ai / 26ai SOC Bridge & Dashboard Environment Configuration
# Copy this file to .env at the repository root and fill in secret values.
# ==============================================================================

# --- Oracle Database Connection ---
ORACLE_USER=sys
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/FREEPDB1
# Authentication mode: sysdba | normal
ORACLE_AUTH_MODE=sysdba
# Set to 1 (or true) to use OS authentication instead of password
ORACLE_OS_AUTH=0
# python-oracledb client mode: thin | thick
ORACLE_CLIENT_MODE=thin
# Optional Oracle Instant Client directory (required only when ORACLE_CLIENT_MODE=thick)
ORACLE_LIB_DIR=

# --- Python IDS/IPS Bridge ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8050
BRIDGE_API_TOKEN=
POLL_INTERVAL_SEC=2.0
MONITORED_USERS=U1,U2,U3,U4
# Optional overrides:
# DETECTION_POLICY_PATH=
# IDS_STATE_FILE=
# MAX_REQUEST_BODY_BYTES=1048576

# --- SOC Web Dashboard (Node/Express) ---
DASHBOARD_URL=http://localhost:3000
DASHBOARD_HOST=127.0.0.1
PORT=3000
SOC_ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to 1 when bridge.py is launched and managed separately from the Node server
BRIDGE_MANAGED_EXTERNALLY=0
