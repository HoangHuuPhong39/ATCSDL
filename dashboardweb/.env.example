# ==============================================================================
# SOC Web Dashboard & Oracle Bridge Environment Configuration
# Prefer configuring the root ../.env file; local overrides can live here.
# ==============================================================================

# --- SOC Web Dashboard (Node/Express) ---
DASHBOARD_URL=http://localhost:3000
DASHBOARD_HOST=127.0.0.1
PORT=3000
SOC_ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BRIDGE_MANAGED_EXTERNALLY=0

# --- Python IDS/IPS Bridge ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8050
BRIDGE_API_TOKEN=
POLL_INTERVAL_SEC=2.0
MONITORED_USERS=U1,U2,U3,U4

# --- Oracle Database Connection ---
ORACLE_USER=sys
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_AUTH_MODE=sysdba
ORACLE_OS_AUTH=0
ORACLE_CLIENT_MODE=thin
ORACLE_LIB_DIR=
